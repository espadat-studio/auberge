[freshrss]
user = {{ freshrss_sys_user }}
group = {{ freshrss_sys_group }}

listen = {{ freshrss_fpm_socket }}
listen.owner = {{ freshrss_sys_user }}
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = 5
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 500

chdir = {{ freshrss_install_path }}

security.limit_extensions = .php

env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMP] = /tmp
env[TMPDIR] = /tmp
env[TEMP] = /tmp
