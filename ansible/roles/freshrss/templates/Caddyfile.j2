{{ freshrss_domain }} {
	tls {
		dns cloudflare {env.{{ freshrss_dns_api_token_env }}}
	}
	root * {{ freshrss_install_path }}/p
	php_fastcgi unix/{{ freshrss_fpm_socket }}
	file_server

	request_body {
		max_size 20M
	}

	encode gzip

	log {
		output file /var/log/caddy/{{ freshrss_domain }}.log
	}
}
