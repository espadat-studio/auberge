{{ colporteur_domain }} {
	tls {
		dns cloudflare {env.{{ colporteur_dns_api_token_env }}}
	}
	basic_auth {
		{{ admin_user_name }} {{ colporteur_hashed_password }}
	}

	root * {{ colporteur_feeds_dir }}
	file_server

	@xml path *.xml
	header @xml Content-Type application/atom+xml

	encode gzip

	log {
		output file /var/log/caddy/{{ colporteur_domain }}.log
	}
}
