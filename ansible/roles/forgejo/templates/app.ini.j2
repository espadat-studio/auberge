APP_NAME = {{ forgejo_app_name }}
RUN_USER = {{ forgejo_sys_user }}
RUN_MODE = prod
WORK_PATH = {{ forgejo_data_dir }}

[server]
PROTOCOL = http
HTTP_ADDR = 127.0.0.1
HTTP_PORT = {{ forgejo_port }}
DOMAIN = {{ forgejo_domain }}
ROOT_URL = https://{{ forgejo_domain }}/
APP_DATA_PATH = {{ forgejo_data_dir }}/data
; Tailnet-only, built-in server. See ADR-0084.
DISABLE_SSH = false
START_SSH_SERVER = true
SSH_CREATE_AUTHORIZED_KEYS_FILE = false
SSH_ROOT_PATH = {{ forgejo_data_dir }}/ssh
SSH_DOMAIN = {{ forgejo_ssh_domain }}
SSH_LISTEN_HOST = {{ forgejo_tailscale_ip }}
SSH_LISTEN_PORT = {{ forgejo_ssh_port }}
SSH_PORT = {{ forgejo_ssh_port }}

[repository]
ROOT = {{ forgejo_data_dir }}/repos
; Editors are collaborators on repositories the admin creates. Admins bypass
; the limit.
MAX_CREATION_LIMIT = 0
; Onboarding migrates nothing, and a migration is a fetch the forge makes on a
; user's behalf.
DISABLE_MIGRATIONS = true

[migrations]
ALLOW_LOCALNETWORKS = false

[webhook]
; Forgejo's own default, declared. "external" excludes loopback, RFC 1918, ULA
; and CGNAT, so a webhook cannot reach a tailnet or Host-local address.
ALLOWED_HOST_LIST = external

[database]
DB_TYPE = sqlite3
PATH = {{ forgejo_data_dir }}/data/forgejo.db

[security]
; The wizard is gated on this being false, so the deploy is the only thing that
; ever configures the instance.
INSTALL_LOCK = true
SECRET_KEY_URI = file:{{ forgejo_config_dir }}/secret_key
INTERNAL_TOKEN_URI = file:{{ forgejo_config_dir }}/internal_token

[oauth2]
; Also the general token signing secret (CSRF, account validation). Forgejo
; generates one into app.ini when it cannot load it, which this file exists to
; prevent.
JWT_SECRET_URI = file:{{ forgejo_config_dir }}/jwt_secret
{% if forgejo_cors_allow_origins | length > 0 %}

[cors]
; Decap runs the OAuth token exchange from the site's own origin, so without
; this the browser blocks it before Forgejo ever sees the request (#945).
ENABLED = true
ALLOW_DOMAIN = {{ forgejo_cors_allow_origins }}
METHODS = GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
HEADERS = Content-Type,User-Agent,Authorization
{% endif %}

[service]
; A public login surface: the admin creates every account.
DISABLE_REGISTRATION = true

[actions]
; Out of scope. Forgejo enables the Actions subsystem by default.
ENABLED = false

[log]
MODE = console
LEVEL = info
