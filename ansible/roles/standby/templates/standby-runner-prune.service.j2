[Unit]
Description=Prune the Standby Runner work dir and cargo registry cache

[Service]
Type=oneshot
User={{ standby_runner_user }}
Group={{ standby_runner_group }}
Environment=STANDBY_RUNNER_WORK_DIR={{ standby_runner_work_dir }}
Environment=STANDBY_RUNNER_CARGO_REGISTRY_DIR={{ standby_runner_cargo_registry_dir }}
Environment=STANDBY_RUNNER_WORK_RETENTION_DAYS={{ standby_runner_work_retention_days }}
Environment=STANDBY_RUNNER_CACHE_CAP_MB={{ standby_runner_cache_cap_mb }}
ExecStart={{ standby_runner_prune_script_path }}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ standby_runner_install_dir }} {{ standby_runner_home }}
UMask=0077
